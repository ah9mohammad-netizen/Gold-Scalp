# ========================================================
# XAU-USDT Gold Edge v7 — adaptive-session forward paper
# ========================================================
# Research only. This configuration cannot enable live execution.

ENV=production
PAPER_TRADING=true
PAPER_BALANCE=100.00
STRATEGY_VERSION=v7-adaptive-session-scalper

SYMBOL=XAU-USDT
EXCHANGE_ID=bybit
TIMEFRAME=5m
POLL_INTERVAL_SECONDS=60
ONLY_CLOSED_CANDLES=true
MAX_DATA_STALENESS_SECONDS=900
# Keep false: PAXG is only a proxy, not the requested XAU-USDT contract.
ALLOW_PROXY_FEEDS=false

# Account controls. v7 additionally hard-caps effective per-trade risk at
# V7_RISK_CAP_PCT and effective daily loss at 2%, even if wider legacy values
# remain in Railway.
MAX_LEVERAGE=50
RISK_PER_TRADE_PCT=0.50
V7_RISK_CAP_PCT=0.50
MAX_SPREAD_USD=0.40
MAX_OPEN_TRADES=1
MAX_DAILY_LOSS_PCT=2.0
MAX_TRADES_PER_DAY=4
ENTRY_COOLDOWN_SECONDS=600
LOSS_COOLDOWN_SECONDS=1200
MARGIN_CAP_PCT=25.0

# v7 liquid session and score router (UTC)
V7_ALLOWED_SESSIONS=6-20
V7_MIN_SIGNAL_SCORE=4
V7_RANGE_Z_ENTRY=1.60
V7_RANGE_ADX_MAX=23.0
V7_TREND_ADX_MIN=18.0
V7_ATR_SHOCK_MULTIPLE=2.20

# Setup-specific geometry and stale-trade exits
V7_RANGE_TP_RR=1.35
V7_TREND_TP_RR=1.60
V7_LIQUIDITY_TP_RR=1.50
V7_BE_TRIGGER_RR=1.00
V7_RANGE_MAX_HOLDING_BARS=8
V7_TREND_MAX_HOLDING_BARS=12
V7_MIN_STOP_COST_MULTIPLE=1.25
V7_MIN_TARGET_COST_MULTIPLE=1.50

# Indicators used by the closed-candle feed
EMA_TREND_PERIOD=200
EMA_FAST_PERIOD=50
EMA_PULLBACK_PERIOD=21
ZSCORE_PERIOD=20
ATR_PERIOD=14
ATR_AVG_LOOKBACK=50
RSI_PERIOD=14
ADX_PERIOD=14
MIN_ATR_USD=0.80

# Conservative execution baseline. Do not select MAKER_POST_ONLY unless a
# separate post-only fill-probability model has been reviewed.
PAPER_EXECUTION_MODE=TAKER
PAPER_TAKER_FEE_RATE=0.0004
PAPER_MAKER_FEE_RATE=0.0001
PAPER_SLIPPAGE_USD=0.03

# Railway Volume
DB_PATH=/data/history.db
DATABASE_URL=sqlite:////data/history.db

# Leave blank locally to disable Telegram. Set both as Railway service variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
